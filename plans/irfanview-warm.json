{
  "schema": "oz.plan.v1",
  "name": "irfanview-reference-warm",
  "subject": {
    "name": "irfanview",
    "executable": "C:\\Program Files\\IrfanView\\i_view64.exe",
    "version_hint": null,
    "enabled": false,
    "skip_reason": "PENDING HUMAN INPUT: confirm install path and version; template is disabled by default and is never auto-discovered or launched"
  },
  "collector": "external_visible_frame",
  "adapter": "oz_desktop_duplication",
  "endpoint": "ExternalFirstImageVisible",
  "cache": "warm",
  "manifest": "../benchmark/manifests/selection.private.json",
  "working_directory": null,
  "timeout_ms": 60000,
  "repetitions": 30,
  "warmups": 3,
  "collector_config": {
    "monitor_index": -1,
    "window_wait_ms": 15000,
    "frame_timeout_ms": 30000,
    "probe": {
      "min_edge_density": 0.3,
      "min_luma_variance": 0.02,
      "min_mean_luma": 0.02,
      "max_mean_luma": 0.98,
      "consecutive_frames": 2
    }
  },
  "args": [
    "{{image_path}}",
    "/ini=\"{{irfanview_isolated_config_dir}}\""
  ],
  "images": [
    {
      "path": "resolved-from-manifest",
      "alias": "jpeg-2mp",
      "format": "jpg",
      "width": null,
      "height": null,
      "size_bytes": null,
      "provenance": "selected by benchmark/scripts/inventory-jpeg.ps1 (sealed private manifest)"
    },
    {
      "path": "resolved-from-manifest",
      "alias": "jpeg-12mp",
      "format": "jpg",
      "width": null,
      "height": null,
      "size_bytes": null,
      "provenance": "selected by benchmark/scripts/inventory-jpeg.ps1 (sealed private manifest)"
    },
    {
      "path": "resolved-from-manifest",
      "alias": "jpeg-24mp",
      "format": "jpg",
      "width": null,
      "height": null,
      "size_bytes": null,
      "provenance": "selected by benchmark/scripts/inventory-jpeg.ps1 (sealed private manifest)"
    }
  ]
}