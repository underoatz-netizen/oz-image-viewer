{
  "schema": "oz.plan.v1",
  "name": "viewer-benchmark",
  "subject": {
    "name": "ozviewer",
    "executable": "{{viewer_exe}}",
    "version_hint": null,
    "enabled": true,
    "skip_reason": ""
  },
  "collector": "markers",
  "adapter": "oz_markers",
  "cache": "cold",
  "working_directory": "{{build_dir}}",
  "timeout_ms": 60000,
  "repetitions": 3,
  "warmups": 1,
  "args": ["--benchmark", "{{image_path}}"],
  "images": [
    {
      "path": "viewer_benchmark_fixture.jpg",
      "format": "jpg",
      "width": null,
      "height": null,
      "size_bytes": null,
      "provenance": "Stage 1 integration JPEG fixture generated by ozviewer_make_jpeg"
    }
  ]
}